# Copy to .env and replace BOTH password placeholders with the same strong password.
# URL-encode special characters in the connection URL password.
AZURAI_POSTGRES_PASSWORD=replace-with-long-password
AZURAI_DATABASE_URL=postgresql://azurai:replace-with-long-password@127.0.0.1:5432/azurai
AZURAI_DIRECTOR_MODEL=qwen2.5:7b
